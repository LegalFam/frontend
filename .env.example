# Base de la API. Relativa = pasa por el proxy de Vite (/api -> localhost:8080),
# asi funciona igual en local y detras de un tunel sin tocar nada.
VITE_API_BASE_URL=/api/v1

# Solo para probar suscripciones con webhooks reales: host publico del tunel
# que apunta a este dev server (sin protocolo). Separar con coma si hay varios.
# Ej: legalfam-dev.ngrok-free.app
VITE_DEV_ALLOWED_HOSTS=
